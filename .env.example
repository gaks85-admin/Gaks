# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Twelve Data API Key used to fetch live market prices and quotes
TWELVE_DATA_API_KEY=

# CRON_SECRET: Secure token for authenticating scheduled Market Watcher CRON executions
CRON_SECRET=

# SUPABASE_URL: URL of your Supabase project.
VITE_SUPABASE_URL=

# SUPABASE_ANON_KEY: Public API key for your Supabase project.
VITE_SUPABASE_ANON_KEY=

# STAGE 8: Execution Mode (THEORETICAL, PAPER, LIVE)
EXECUTION_MODE=PAPER

# STAGE 8: Live Trading Safety Switch (must be 'true' for live orders to actually fire)
LIVE_TRADING_ENABLED=false

# STAGE 8: Global Trading Kill Switch (if 'false', all trading loops are halted)
GLOBAL_TRADING_ENABLED=true

# STAGE 7/8: Broker Safety Thresholds
BROKER_MAX_SPREAD_PERCENT=0.0005
BROKER_MAX_ENTRY_DRIFT_PERCENT=0.001
BROKER_QUOTE_MAX_AGE_MS=5000
